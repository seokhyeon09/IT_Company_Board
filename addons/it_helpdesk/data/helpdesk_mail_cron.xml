<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 실제 이메일 알림 발송 스위치 (기본 꺼짐) -->
        <record id="config_send_real_mail" model="ir.config_parameter">
            <field name="key">it_helpdesk.send_real_mail</field>
            <field name="value">False</field>
        </record>

        <!-- 실제 이메일 알림 발송 스케줄러 (1분 주기) -->
        <record id="cron_send_real_mail" model="ir.cron">
            <field name="name">IT 헬프데스크: 알림 메일 발송 (1분 주기)</field>
            <field name="model_id" ref="model_it_helpdesk_mail_dispatch"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_real_mail()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
