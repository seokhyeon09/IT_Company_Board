<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 장기 미평가 해결 티켓 자동 종결 스케줄러 (해결완료 후 7일 경과 시 closed 전환) -->
        <record id="cron_auto_close_resolved_tickets" model="ir.cron">
            <field name="name">IT 헬프데스크: 미평가 해결 티켓 자동 종결 (7일 경과)</field>
            <field name="model_id" ref="model_it_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_close_resolved_tickets(days=7)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
