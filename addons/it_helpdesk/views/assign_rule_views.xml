<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_assign_rule_list" model="ir.ui.view">
        <field name="name">it.helpdesk.assign.rule.list</field>
        <field name="model">it.helpdesk.assign.rule</field>
        <field name="arch" type="xml">
            <list string="분야별 담당자 규칙">
                <field name="category"/>
                <field name="officer_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_assign_rule_form" model="ir.ui.view">
        <field name="name">it.helpdesk.assign.rule.form</field>
        <field name="model">it.helpdesk.assign.rule</field>
        <field name="arch" type="xml">
            <form string="분야별 담당자 규칙">
                <sheet>
                    <group>
                        <field name="category"/>
                        <field name="officer_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_assign_rule" model="ir.actions.act_window">
        <field name="name">분야별 담당자 규칙</field>
        <field name="res_model">it.helpdesk.assign.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_helpdesk_assign_rule"
        name="분야별 담당자 규칙"
        parent="menu_helpdesk_manager_root"
        action="action_helpdesk_assign_rule"
        sequence="20"
        groups="it_helpdesk.group_helpdesk_manager"
    />
</odoo>
