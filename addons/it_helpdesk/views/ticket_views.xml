<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 게시글 칸반(보드) 뷰 -->
    <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.kanban</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" sample="1">
                <field name="status"/>
                <field name="priority"/>
                <field name="author_id"/>
                <field name="assignee_id"/>
                <field name="is_officer"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-1">
                            <field name="priority" widget="priority" readonly="not is_officer and author_id != uid"/>
                            <field name="category" class="badge text-bg-light ms-auto"/>
                        </div>
                        <div class="mb-2">
                            <field name="title" class="fw-bold fs-5"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <span class="fa fa-user me-1" title="요청자"/>
                            <field name="author_id"/>
                        </div>
                        <footer class="pt-1 mt-auto d-flex align-items-center">
                            <field name="create_date" widget="date" class="text-muted small"/>
                            <field name="deadline" widget="remaining_days" class="ms-2 small" decoration-danger="is_overdue"/>
                            <field name="assignee_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 게시글목록 -->
    <record id="view_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.list</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="문의 목록" decoration-muted="status in ('closed', 'canceled')" class="container">
                <field name="is_officer" column_invisible="True"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="status" 
                       widget="badge" 
                       width="110px"
                       decoration-info="status == 'submitted'"
                       decoration-warning="status in ('assigned', 'pending')"
                       decoration-primary="status == 'in_progress'"
                       decoration-success="status in ('resolved', 'closed')"
                       decoration-muted="status == 'canceled'"/>
                <field name="category" width="130px"/>
                <field name="priority" widget="priority" readonly="not is_officer and author_id != uid"/>
                <!-- 제목은 width를 적지 않아야 남은 공간을 알아서 꽉 채워줍니다 -->
                <field name="title" class="fw-bold"/>
                <field name="author_id" width="120px"
                    decoration-bf="author_id == uid"
                    decoration-info="author_id == uid"
                />
                <field name="assignee_name" 
                    width="130px"
                    decoration-muted="assignee_name == '배정 대기'"
                    decoration-success="assignee_name != '배정 대기'"/>
                <field name="deadline" string="처리 기한" widget="remaining_days" width="130px" decoration-danger="is_overdue"/>
                <field name="create_date" string="접수일시" width="160px"/>
                <field name="rating" widget="priority" string="만족도" optional="show"/>
                <field name="is_faq" string="FAQ 추천" widget="boolean_favorite" optional="show" readonly="not is_officer"/>
            </list>
        </field>
    </record>

    <!-- 게시글상세 -->
    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.form</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="IT 문의">
                <header>

                    <button
                        name="action_assign_to_me"
                        string = "담당 접수"
                        type = "object"
                        class = "oe_highlight"
                        invisible = "status != 'submitted'"
                    />

                    <button
                        name = "action_start_progress"
                        string = "처리 시작"
                        type = "object"
                        class = "oe_highlight"
                        invisible = "status != 'assigned'"
                    />

                    <button
                        name="action_pending"
                        string = "답변 대기"
                        type="object"
                        class="oe_highlight"
                        invisible="status!='in_progress'"
                    />

                    <button
                        name = "action_restart_ticket"
                        string = "재문의"
                        type = "object"
                        class = "oe_highlight"
                        invisible = "status != 'pending'"
                    />

                    <button
                        name="action_resolve"
                        string = "해결 완료"
                        type="object"
                        class="oe_highlight"
                        invisible="status not in ('in_progress', 'pending')"
                    />

                    <button
                        name="action_close"
                        string = "문의 종결"
                        type="object"
                        class="oe_highlight"
                        invisible="status != 'resolved'"
                    />
                    
                    <button
                        name="action_cancel"
                        string = "문의 취소"
                        type="object"
                        class="btn-secondary"
                        invisible="status in ('pending','resolved', 'closed', 'canceled')"
                    />

                    <button
                        name="action_reopen"
                        string="문의 재오픈"
                        type="object"
                        class="btn-secondary"
                        invisible = "status not in ('closed', 'canceled') or not is_officer"
                    />

                    <button
                        name="action_toggle_faq"
                        string="FAQ 등록/해제"
                        type="object"
                        class="btn-outline-info"
                        invisible="status not in ('resolved', 'closed') or not is_officer"
                    />

                    <field name="status"
                    widget="statusbar"
                    statusbar_visible="submitted,assigned,in_progress,pending,resolved,closed"/>

                </header>
                <sheet class="mx-auto">
                    <field name="is_overdue" invisible="True"/>
                    <div class="alert alert-danger mb-3" role="alert" invisible="not is_overdue">
                        <i class="fa fa-exclamation-triangle me-2" title="경고"/>
                        <strong>SLA 처리 기한 초과:</strong> 본 문의는 약속된 처리 기한을 초과하였습니다. 신속한 조치가 필요합니다.
                    </div>
                    <field name="is_faq" invisible="True"/>
                    <div class="alert alert-info mb-3" role="alert" invisible="not is_faq">
                        <i class="fa fa-book me-2" title="지식베이스"/>
                        <strong>사내 FAQ 지식베이스:</strong> 본 문의는 전사 사원에게 유용한 해결 사례로 선정된 공식 FAQ 게시글입니다.
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">IT 문의 타이틀</span>
                        <h1>
                            <field name="title" placeholder="문의 제목 입력하세요" readonly="status not in ('submitted','assigned')"/>
                        </h1>
                    </div>
                    <group>
                        <!-- 왼쪽 열 -->
                        <group string="문의 분류">
                            <field name="category" readonly="status in ('closed','canceled') or (not is_officer and author_id != uid)"/>
                            <field name="priority" widget="priority" readonly="status in ('closed','canceled') or (not is_officer and author_id != uid)"/>
                            <field name="deadline" readonly="status in ('closed','canceled') or not is_officer"/>
                        </group>
    
                        <!-- 오른쪽 열 -->
                        <group string="담당 및 요청자">
                            <group><field name="author_id"/></group>
                            <group><field name="assignee_name"/></group>
                        </group>
                    </group>
                    <notebook>
                        <page string="문의 상세 내용">
                            <field name="content" placeholder="발생한 문제 상황이나 증상을 자세히 기재해 주세요." readonly="status not in ('submitted','assigned')"/>
                        </page>
                        <page string="공식 조치 내역">
                            <field name="resolution_note" placeholder="IT 담당자가 문제를 어떻게 해결했는지 공식 조치 내역을 기록합니다." readonly="status in ('closed', 'canceled') or not is_officer"/>
                        </page>
                        <page string="고객 만족도 평가" invisible="status not in ('resolved', 'closed')">
                            <group>
                                <group string="조치 만족도">
                                    <field name="rating" widget="priority" readonly="author_id != uid"/>
                                    <field name="rating_comment" placeholder="서비스에 대한 솔직한 의견이나 감사의 말씀을 남겨주세요." readonly="author_id != uid"/>
                                </group>
                            </group>
                            <div class="mt-2" invisible="author_id != uid">
                                <button name="action_submit_rating" string="만족도 평가 제출" type="object" class="btn-primary"/>
                            </div>
                        </page>
                        <page string="고객 만족도 평가" invisible="status not in ('resolved', 'closed')">

                            <group>

                                <group string="조치 만족도">

                                    <field name="rating" widget="priority" readonly="author_id != uid"/>

                                    <field name="rating_comment" placeholder="서비스에 대한 솔직한 의견이나 감사의 말씀을 남겨주세요." readonly="author_id != uid"/>

                                </group>

                            </group>

                            <div class="mt-2" invisible="author_id != uid">

                                <button name="action_submit_rating" string="만족도 평가 제출" type="object" class="btn-primary"/>

                            </div>

                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.search</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="문의 검색">
                <field name="title" string="제목"/>
                <field name="author_id" string="작성자"/>
                <field name="assignee_id" string="담당자"/>
                <field name="category" string="카테고리"/>

                <filter string="📘 FAQ 지식창고" name="filter_faq" domain="[('is_faq', '=', True)]"/>
                <filter string="🚨 SLA 기한 초과" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="내 문의" name="my_ticket" domain="[('author_id','=',uid)]"/>
                <separator/>
                <filter string="배정대기" name="unassigned" domain="[('assignee_id','=',False)]"/>
                <filter string="접수 대기" name="filter_submitted" domain="[('status','=','submitted')]"/>
                <filter string="처리중" name="filter_in_progress" domain="[('status','in',('assigned','in_progress','pending'))]"/>
                <filter string="긴급도건(높음/긴급)" name="filter_in_priority" domain="[('priority', 'in', ('2','3'))]"/>
            
                <group expand="0" string="그룹화">
                    <filter string="상태별" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="카테고리별" name="group_category" context="{'group_by':'category'}"/>
                    <filter string="담당자별" name="group_assignee" context="{'group_by':'assignee_id'}"/>
                    <filter string="긴급도별" name="group_priority" context="{'group_by':'priority'}"/>
                    <filter string="만족도별" name="group_rating" context="{'group_by':'rating'}"/>
                </group>
            </search>
            
        </field>
    </record>


    <!-- 통계 피벗(Pivot) 분석 뷰 -->
    <record id="view_helpdesk_ticket_pivot" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.pivot</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <pivot string="문의 현황 피벗 분석" sample="1">
                <field name="status" type="col"/>
                <field name="category" type="row"/>
                <field name="priority" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- 통계 차트(Graph) 뷰 -->
    <record id="view_helpdesk_ticket_graph" model="ir.ui.view">
        <field name="name">it.helpdesk.ticket.graph</field>
        <field name="model">it.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <graph string="문의 현황 통계 차트" type="bar" sample="1">
                <field name="category"/>
                <field name="status"/>
            </graph>
        </field>
    </record>

    <!--  액션 (리모컨: 메뉴를 눌렀을 때 목록과 폼 화면을 열어주는 명령) -->
    <record id="action_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">전체 문의 목록</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
    </record>

    <record id="action_helpdesk_ticket_my" model="ir.actions.act_window">
        <field name="name">내 문의 목록</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="domain">[('author_id','=',uid)]</field>
    </record>

    <record id="action_helpdesk_ticket_unassigned" model="ir.actions.act_window">
        <field name="name">미배정 대기</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="domain">[('assignee_id','=',False)]</field>
    </record>


    <record id="action_helpdesk_ticket_analysis" model="ir.actions.act_window">
        <field name="name">문의 통계 및 분석</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">graph,pivot</field>
    </record>


    <record id="action_helpdesk_ticket_faq" model="ir.actions.act_window">
        <field name="name">자주 묻는 질문 (FAQ)</field>
        <field name="res_model">it.helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_faq', '=', True)]</field>
    </record>

    <!-- 메인메뉴 -->
    <menuitem id="menu_helpdesk_root" name="IT 헬프데스크" sequence="10"/>
    <!-- 서브메뉴 -->
    <menuitem id="menu_helpdesk_ticket" 
        name="전체 문의 목록" 
        parent="menu_helpdesk_root" 
        action="action_helpdesk_ticket" 
        sequence="10"
    />
    <menuitem id="menu_helpdesk_ticket_my" 
        name="내 문의 목록" 
        parent="menu_helpdesk_root" 
        action="action_helpdesk_ticket_my" 
        sequence="20"
    />
    <menuitem id="menu_helpdesk_ticket_unassigned" 
        name="미배정 문의 목록" 
        parent="menu_helpdesk_root" 
        action="action_helpdesk_ticket_unassigned" 
        sequence="30"
    />

    <menuitem id="menu_helpdesk_ticket_analysis" 
        name="문의 통계 및 분석" 
        parent="menu_helpdesk_root" 
        action="action_helpdesk_ticket_analysis" 
        sequence="40"
    />

    <menuitem id="menu_helpdesk_ticket_faq" 
        name="FAQ 지식창고" 
        parent="menu_helpdesk_root" 
        action="action_helpdesk_ticket_faq" 
        sequence="25"
    />

</odoo>