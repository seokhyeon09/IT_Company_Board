<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_it_helpdesk" model="ir.module.category">
        <field name="name">IT 헬프 데스크</field>
        <field name="sequence">20</field>

    </record>
    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">사원</field>
        <field name="category_id" ref="module_category_it_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_helpdesk_officer" model="res.groups">
        <field name="name">담당자</field>
        <field name="category_id" ref="module_category_it_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>
    
</odoo>