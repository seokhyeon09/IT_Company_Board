<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_it_helpdesk" model="ir.module.category">
        <field name="name">IT 헬프 데스크</field>
        <field name="sequence">20</field>

    </record>
    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">사원</field>
        <field name="category_id" ref="module_category_it_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_helpdesk_officer" model="res.groups">
        <field name="name">담당자</field>
        <field name="category_id" ref="module_category_it_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>
    
    <record id="helpdesk_ticket_rule_user" model="ir.rule">
        <field name="name">내 문의만 조회</field>
        <field name="model_id" ref="model_it_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="domain_force">[('author_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
    </record>

    <record id="helpdesk_ticket_rule_officer" model="ir.rule">
        <field name="name">모든 문의 조회</field>
        <field name="model_id" ref="model_it_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>