# ==============================================================================
# 사내 IT 헬프데스크 (IT Company Board) 환경변수 설정 예시
# 본 파일을 복사하여 .env 파일을 생성한 뒤 실제 환경에 맞게 값을 설정하세요.
# ==============================================================================

# PostgreSQL 데이터베이스 설정
DB_NAME=postgres
DB_USER=odooU
DB_PASSWORD=odooPW

# Slack 인커밍 웹훅 연동 (선택 사항)
# 긴급(priority 3) 티켓 접수 및 SLA 에스컬레이션 발생 시 지정된 Slack 채널로 알림을 전송합니다.
# 비워둘 경우(기본값) 웹훅 전송 기능이 안전하게 비활성화됩니다.
SLACK_WEBHOOK_URL=

# 프론트엔드 기본 접속 URL (Slack 알림 메시지 내 티켓 바로가기 링크 생성용)
FRONTEND_BASE_URL=http://localhost:3000
