# ==============================================================================
# 사내 IT 헬프데스크 (IT Company Board) 환경변수 설정 예시
# 본 파일을 복사하여 .env 파일을 생성한 뒤 실제 환경에 맞게 값을 설정하세요.
# ==============================================================================

# PostgreSQL 데이터베이스 설정
DB_NAME=postgres
DB_USER=odooU
DB_PASSWORD=odooPW

# Slack 인커밍 웹훅 연동 (선택 사항)
# 긴급(priority 3) 티켓 접수 및 SLA 에스컬레이션 발생 시 지정된 Slack 채널로 알림을 전송합니다.
# 비워둘 경우(기본값) 웹훅 전송 기능이 안전하게 비활성화됩니다.
SLACK_WEBHOOK_URL=

# 프론트엔드 기본 접속 URL (Slack 알림 메시지 내 티켓 바로가기 링크 생성용)
FRONTEND_BASE_URL=http://localhost:3000

# 필수: 인증 비밀키 (미설정이면 docker compose가 기동되지 않습니다)
# 각각 32자 이상의 서로 다른 무작위 값을 생성해 넣으세요. 예시값/공개된 값은 게이트웨이가 거부합니다.
#   생성: python -c "import secrets; print(secrets.token_hex(32))"
# GATEWAY_SHARED_SECRET: 게이트웨이와 Odoo 사이 HMAC 서명 키, JWT_SECRET_KEY: 로그인 토큰 서명 키
# (값을 바꾸면 기존 로그인 토큰은 모두 무효가 되어 재로그인이 필요합니다)
GATEWAY_SHARED_SECRET=
JWT_SECRET_KEY=

# 게이트웨이 레이트 리미터가 X-Forwarded-For 헤더를 신뢰할지 여부 (기본 false)
# 게이트웨이 앞에 클라이언트 IP를 덧붙여 주는 리버스 프록시(nginx 등)가 있을 때만 true로 설정하세요.
# 프록시 없이 직접 노출된 상태에서 true이면 헤더 위조로 로그인 시도 제한을 우회할 수 있습니다.
TRUST_PROXY_HEADERS=false
